{
  "name": "@motor-combat-moba/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playtest/tsconfig.json && tsc --noEmit -p balance/tsconfig.json",
    "test": "vitest run",
    "test:slow": "vitest run -c vitest.slow.config.ts --passWithNoTests",
    "test:bench": "vitest run -c vitest.bench.config.ts",
    "test:common": "vitest run --exclude \"**/modes/*/**\"",
    "test:mode": "vitest run",
    "playtest": "tsx playtest/run-all.ts",
    "playtest:lan": "tsx playtest/lan.ts",
    "balance": "tsx balance/run.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.17",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.4",
    "@motor-combat-moba/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "tsup": "^8.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
