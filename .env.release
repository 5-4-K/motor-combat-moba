# Baked into the release as `.env` by `npm run build:release`, so the LAN host runs on this
# configuration without editing anything after unzipping. Comments survive the copy.
#
# To change a value for your machine only, create `.env.release.local` (gitignored) with just the
# keys you want to override — it is merged over this file, key by key, at build time.

DEPLOY_MODE=lan

# Port 80 lets players reach the game by hostname alone (`http://gamepc`), with no `:port` to
# memorise. Windows binds it without admin rights; on Linux/macOS it is privileged — see
# docs/deployment.md.
PORT=80

# Blank means "use the built-in default".
TICK_RATE_HZ=
SIM_LATENCY_MS=
SIM_JITTER_MS=
